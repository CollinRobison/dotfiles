#!/bin/sh
set -eu
script=$0
while [ -L "$script" ]; do
  target=$(readlink "$script")
  case "$target" in
    /*) script=$target ;;
    *) script=$(dirname "$script")/$target ;;
  esac
done
base=$(CDPATH='' cd -- "$(dirname "$script")" && pwd)
exec "${NVIM_KEYMAPS_PYTHON:-python3}" -B "$base/server.py" "$@"
